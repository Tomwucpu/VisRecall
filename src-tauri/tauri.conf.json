{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisRecall",
  "version": "0.1.0",
  "identifier": "com.visrecall.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../models/manifest.json": "models/manifest.json",
      "../models/bge-small-zh-v1.5-int8.onnx": "models/bge-small-zh-v1.5-int8.onnx",
      "../models/ch_PP-OCRv4_det_infer.onnx": "models/ch_PP-OCRv4_det_infer.onnx",
      "../models/ch_PP-OCRv4_rec_infer.onnx": "models/ch_PP-OCRv4_rec_infer.onnx",
      "../models/onnxruntime.dll": "models/onnxruntime.dll",
      "../models/ppocr_keys_v1.txt": "models/ppocr_keys_v1.txt",
      "../models/tokenizer.json": "models/tokenizer.json",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "installer/LICENSE-MIT-Tauri.txt": "LICENSE-MIT-Tauri-Installer.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "template": "installer/installer.nsi"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
